# Añadir únicamente las opciones necesarias a .env.local existente.
# No reemplazar DATABASE_URL, las credenciales MQTT ni PANEL_PASSWORD.
WHATSAPP_MODE=manual

# Solo para la integración automática opcional con Meta:
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TO=
WHATSAPP_ALTERNATE_TO=
WHATSAPP_TEMPLATE_NAME=asistencia_unt
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_MAX_AGE_SECONDS=300
